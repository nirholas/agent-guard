  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "start": "node bin/agent-guard.js start"
  },
  "keywords": ["ai-agents", "agent-security", "prompt-injection", "egress-proxy", "mcp", "llm-security", "audit-log", "credential-vault", "kill-switch", "guardrails", "agentic", "ai-safety"],
  "repository": { "type": "git", "url": "git+https://github.com/nirholas/agent-guard.git" },
  "homepage": "https://nirholas.github.io/agent-guard/",
